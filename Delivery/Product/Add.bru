meta {
  name: Add
  type: http
  seq: 2
}

post {
  url: {{URL}}/product/create
  body: multipartForm
  auth: inherit
}

headers {
  Authorization: {{TOKEN}}
}

body:multipart-form {
  name: teste @contentType(multipart/form-data)
  description: teste @contentType(multipart/form-data)
  price: 5 @contentType(multipart/form-data)
  categoryId: 5 @contentType(multipart/form-data)
  imageUrl: teste @contentType(multipart/form-data)
}

settings {
  encodeUrl: true
  timeout: 0
}
